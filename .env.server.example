# Copy to .env.server on the server. Domain only: no https:// or trailing slash.
APP_DOMAIN=progress.example.com
ACME_EMAIL=owner@example.com
PYPI_INDEX_URL=https://pypi.org/simple
# For a release, set BOTH to its full git commit. Keep old image tags for rollback.
# Defaults below preserve the previous server image name for existing deployments.
IMAGE_TAG=server
APP_VERSION=development
DJANGO_SECRET_KEY=请替换为至少50位随机字符串
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为强密码
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=180
GUNICORN_TIMEOUT=60
SECURE_HSTS_SECONDS=31536000
# Preserve this name during upgrades. Change only when restoring into a new volume.
TRACKER_DATA_VOLUME=meeting-progress-tracker_tracker_data
# Caddy is the only trusted source for its overwritten client IP header.
# Change both together if this private subnet conflicts with the server network.
TRACKER_PROXY_SUBNET=172.30.7.0/29
TRACKER_PROXY_IP=172.30.7.2
